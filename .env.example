# PostgreSQL 16+
DATABASE_URL=postgres://user:password@localhost:5432/crypto2books
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Encrypts bexio tokens and API keys at rest.
APP_ENCRYPTION_KEY=
# Public URL of the app. bexio redirect URL to register in the bexio developer portal: ${APP_URL}/api/bexio/callback
APP_URL=http://localhost:3000
# bexio app credentials (developer.bexio.com). Leave empty to run without bexio.
BEXIO_CLIENT_ID=
BEXIO_CLIENT_SECRET=
# Optional: CoinGecko API key for historical CHF prices. COINGECKO_PLAN=pro for paid keys.
COINGECKO_API_KEY=
COINGECKO_PLAN=demo
# Optional: free Etherscan API key (etherscan.io/apis) to read Ethereum addresses.
ETHERSCAN_API_KEY=
# Free trial length in days
TRIAL_DAYS=30
# E-mail for "forgot password" links, sent through Brevo (brevo.com). API key: restricted, "Emails transactionnels" = Tous.
# MAIL_FROM must be a sender or domain verified in Brevo. Without them, production shows "e-mail not configured";
# in development the link is printed in the server log.
BREVO_API_KEY=
MAIL_FROM=Crypto2Books <contact@crypto2books.ch>
# Address that receives an e-mail for each new platform request (default contact@crypto2books.ch).
PLATFORM_REQUEST_NOTIFY_TO=
